{
  "name": "koishi-plugin-github-release-group-file",
  "version": "0.1.3",
  "description": "监控 GitHub Release，按镜像优先级流式下载并校验附件后将绝对路径交给 OneBot 上传到 QQ 群文件夹。",
  "author": "qiyinxi",
  "homepage": "https://github.com/qiyinxi/koishi-plugin-github-release-group-file#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiyinxi/koishi-plugin-github-release-group-file.git"
  },
  "bugs": {
    "url": "https://github.com/qiyinxi/koishi-plugin-github-release-group-file/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "npm run build && node scripts/live-release-smoke.cjs",
    "prepack": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "github",
    "release",
    "onebot",
    "qq",
    "group-file"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@koishijs/plugin-http": "^0.6.3",
    "koishi": "^4.18.11",
    "koishi-plugin-adapter-onebot": "^6.9.4"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-http": "^0.6.3",
    "@types/node": "^22.15.0",
    "koishi": "^4.18.11",
    "koishi-plugin-adapter-onebot": "^6.9.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "koishi": {
    "description": {
      "zh": "监控 GitHub Release，按 CNB、AUTO-MAS 镜像、GitHub 的顺序流式下载并校验匹配附件，再上传到主人确认的 QQ 群文件夹。"
    },
    "service": {
      "required": [
        "database",
        "http"
      ]
    }
  }
}
